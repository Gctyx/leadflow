# ============================================================================
# Leadflow Engine — variáveis de ambiente (copie para .env). Valores abaixo são PLACEHOLDERS fictícios.
# Em produção, injete os segredos via secret manager / variáveis do orquestrador; nunca comite o .env.
# ============================================================================
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# true somente atrás de proxy/LB confiável (necessário para o rate limit enxergar o IP real do cliente)
TRUST_PROXY=false
DEFAULT_PHONE_REGION=BR

# --- MySQL 8 ---------------------------------------------------------------
DATABASE_URL=mysql://leadflow:leadflow@127.0.0.1:3306/leadflow
DB_POOL_SIZE=10

# --- Redis (Streams para a fila de webhooks + contadores de rate limit; sem BullMQ) ---
REDIS_URL=redis://127.0.0.1:6379
REDIS_STREAM_KEY=leadflow:webhooks
REDIS_STREAM_GROUP=leadflow-workers

# --- Segurança -------------------------------------------------------------
# Listas separadas por vírgula (mín. 16 caracteres cada). Mais de um valor = rotação sem downtime
# (o primeiro é o atual; os demais continuam válidos até serem removidos).
API_KEYS=dev-api-key-change-me-0001
WEBHOOK_SECRETS=dev-webhook-secret-change-me-0001
# Janela aceita entre o timestamp assinado e a hora do servidor (proteção contra replay)
WEBHOOK_TOLERANCE_SECONDS=300
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_API_MAX=120
RATE_LIMIT_WEBHOOK_MAX=600

# --- Worker / resiliência ----------------------------------------------------
# true  = o worker roda dentro do processo da API (simples, bom para dev)
# false = processo separado: `npm run start:worker` (recomendado em produção; escala independente)
WORKER_INLINE=true
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_BACKOFF_BASE_MS=2000
WEBHOOK_BACKOFF_MAX_MS=300000
WEBHOOK_LOCK_SECONDS=60
WORKER_SWEEP_INTERVAL_MS=5000
WORKER_BATCH=10

# --- Documentação interativa (Swagger UI em /docs, contrato em /openapi.json) --------------------
# false = desliga as duas rotas (recomendado se a API for exposta publicamente)
DOCS_ENABLED=true

# --- Admin (Auth) ------------------------------------------------------------
# JWT RS256: informe um JWK privado (JSON) com { kty:"RSA", n, e, d, p, q, dp, dq, qi } e um kid. Gere com: `npx jose-util jwk gen --alg RS256 --use sig` e mantenha em segredo.
ADMIN_JWT_PRIVATE_JWK={"kty":"RSA","n":"...","e":"AQAB","d":"...","kid":"leadflow-admin-1"}
ADMIN_JWT_AUDIENCE=leadflow-admin
ADMIN_ACCESS_TTL_SECONDS=600
ADMIN_REFRESH_TTL_DAYS=30
ADMIN_MFA_REQUIRED=true
ADMIN_AT_REST_KEY=CHANGE_ME_hex_32bytes_min            # chave hex (>=32 bytes) para criptografar segredo TOTP em repouso (AES-256-GCM)

# OAuth2/OIDC Providers (opcionais; se não informados, o recurso fica desativado)
ADMIN_OAUTH_GOOGLE_CLIENT_ID=
ADMIN_OAUTH_GOOGLE_CLIENT_SECRET=
ADMIN_OAUTH_GOOGLE_ISSUER=https://accounts.google.com
ADMIN_OAUTH_MICROSOFT_CLIENT_ID=
ADMIN_OAUTH_MICROSOFT_CLIENT_SECRET=
ADMIN_OAUTH_MICROSOFT_ISSUER=https://login.microsoftonline.com/common/v2.0
ADMIN_OAUTH_GITHUB_CLIENT_ID=
ADMIN_OAUTH_GITHUB_CLIENT_SECRET=
ADMIN_OAUTH_GITHUB_ISSUER=https://github.com

# --- Docker Compose ----------------------------------------------------------
# O launcher (Leadflow.exe / leadflow-*) gera TODOS os valores abaixo, e os segredos acima, com aleatoriedade
# criptográfica na primeira execução. O compose roda com NODE_ENV=production, que RECUSA segredos de exemplo
# ("change-me"/"CHANGE_ME").
LEADFLOW_PORT=3000
MYSQL_PASSWORD=CHANGE_ME_mysql_password
MYSQL_ROOT_PASSWORD=CHANGE_ME_mysql_root_password
REDIS_PASSWORD=CHANGE_ME_redis_password
# Em produção atrás de um load balancer (Nginx/ALB), defina TRUST_PROXY=true para ver o IP real do cliente via X-Forwarded-For.
# --- Backups (XtraBackup) -----------------------------------------------------
# Modo de armazenamento: 'local' (volume mysql-backups) ou 's3' (usar xbcloud/awscli nos scripts)
BACKUP_CONCURRENCY=2
BACKUP_RETENTION_FULL=7
BACKUP_RETENTION_INC=48
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
