{
  "name": "leadflow",
  "version": "1.0.0",
  "description": "Leadflow Engine — API para receber, deduplicar e distribuir leads comerciais (LexVita / Desafio Backend Sênior)",
  "main": "dist/server.js",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "migrate": "tsx src/infra/migrate.ts",
    "migrate:prod": "node dist/infra/migrate.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "webhook:sign": "tsx scripts/sign-webhook.ts",
    "diagrams": "bash scripts/render-diagrams.sh",
    "docs:openapi": "tsx scripts/export-openapi.ts",
    "docker:up": "docker compose up --build",
    "launcher:test": "node --test launcher/test/",
    "launcher:build": "node scripts/build-launcher.mjs",
    "test:ci": "vitest run --reporter=verbose"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "argon2": "^0.41.1",
    "jose": "^5.9.6",
    "openid-client": "^6.2.5",
    "otplib": "^13.6.0",
    "ioredis": "^5.6.1",
    "libphonenumber-js": "^1.12.9",
    "mysql2": "^3.14.1",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.30",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "supertest": "^7.1.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "esbuild": "^0.25.5",
    "postject": "1.0.0-alpha.6"
  }
}
